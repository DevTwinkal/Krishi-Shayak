# AI — Free tier, get key at https://console.groq.com (no credit card needed)
GROQ_API_KEY=

# Weather — Optional free tier at https://openweathermap.org/api
# Without this, AI-generated seasonal estimates are used instead
OPENWEATHER_API_KEY=

# Firebase — from Firebase Console → Project Settings → Your Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App URL
VITE_APP_URL=http://localhost:3000
